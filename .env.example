# ==============================================================================
# Language Translation System with MLOps Monitoring
# Environment Configuration Template
# ==============================================================================

# Project Name
PROJECT_NAME="Language Translation System with MLOps Monitoring"

# Database Configuration (PostgreSQL in production, SQLite fallback in local development)
DATABASE_URL="postgresql://translateml:translateml_secure_pw2026@localhost:5432/translateml_db"
POSTGRES_USER="translateml"
POSTGRES_PASSWORD="translateml_secure_pw2026"
POSTGRES_DB="translateml_db"

# Security & JWT Token Generation
SECRET_KEY="generate-a-cryptographically-secure-random-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin User Provisioning (Created safely on first startup)
INITIAL_ADMIN_EMAIL="admin@translateml.edu"
INITIAL_ADMIN_PASSWORD="ReplaceWithStrongAdminPassword2026!"
INITIAL_ADMIN_NAME="Prof. Translation Admin"

# Model Registry & Active NMT Deployment
ACTIVE_MODEL_NAME="M2M100-Indic-v2.1"
ACTIVE_MODEL_VERSION="v2.1"

# Monitoring & Grafana
GRAFANA_USER="admin"
GRAFANA_PASSWORD="ReplaceWithSecureGrafanaPassword!"
